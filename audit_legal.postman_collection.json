{
  "info": {
    "name": "AUDIT Legal - doisanh API",
    "description": "Toan bo API service doi sanh (app.doisanh.api). Base URL mac dinh http://localhost:8010. Doi bien {{base_url}} va {{tai_lieu_id}} trong tab Variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8010" },
    { "key": "tai_lieu_id", "value": "TL-xxxx" }
  ],
  "item": [
    {
      "name": "GET / (UI trang chu)",
      "request": { "method": "GET", "url": { "raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""] } }
    },
    {
      "name": "GET /healthz",
      "request": { "method": "GET", "url": { "raw": "{{base_url}}/healthz", "host": ["{{base_url}}"], "path": ["healthz"] } }
    },
    {
      "name": "POST /ask (hoi dap)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"cau_hoi\": \"Thoi gio lam them toi da bao nhieu?\",\n  \"top_k\": 8,\n  \"is_local\": null\n}" },
        "url": { "raw": "{{base_url}}/ask", "host": ["{{base_url}}"], "path": ["ask"] }
      }
    },
    {
      "name": "GET /legal (danh sach VB trong kho)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/legal?con_hieu_luc=true",
          "host": ["{{base_url}}"], "path": ["legal"],
          "query": [{ "key": "con_hieu_luc", "value": "true" }]
        }
      }
    },
    {
      "name": "POST /upload/legal (nap 1 VB luat tu file)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": [] },
            { "key": "meta_json", "type": "text", "value": "{\"id\":\"139264\",\"so_hieu\":\"45/2019/QH14\",\"ten\":\"Bo luat Lao dong\",\"loai\":\"Bo luat\",\"cap\":\"luat\"}" }
          ]
        },
        "url": { "raw": "{{base_url}}/upload/legal", "host": ["{{base_url}}"], "path": ["upload", "legal"] }
      }
    },
    {
      "name": "POST /upload/draft (upload du thao -> tai_lieu_id)",
      "request": {
        "method": "POST",
        "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": [] }] },
        "url": { "raw": "{{base_url}}/upload/draft", "host": ["{{base_url}}"], "path": ["upload", "draft"] }
      }
    },
    {
      "name": "POST /audit (doi chieu -> JSON)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"tai_lieu_id\": \"{{tai_lieu_id}}\",\n  \"top_k\": 5,\n  \"van_ban_me_ids\": null,\n  \"is_local\": null\n}" },
        "url": { "raw": "{{base_url}}/audit", "host": ["{{base_url}}"], "path": ["audit"] }
      }
    },
    {
      "name": "POST /audit/docx (audit + tao file track-change)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"tai_lieu_id\": \"{{tai_lieu_id}}\",\n  \"top_k\": 5,\n  \"is_local\": null\n}" },
        "url": { "raw": "{{base_url}}/audit/docx", "host": ["{{base_url}}"], "path": ["audit", "docx"] }
      }
    },
    {
      "name": "GET /audit/docx/{tai_lieu_id} (tai file track-change)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/audit/docx/{{tai_lieu_id}}", "host": ["{{base_url}}"], "path": ["audit", "docx", "{{tai_lieu_id}}"] }
      }
    },
    {
      "name": "DELETE /draft/{tai_lieu_id} (xoa 1 du thao)",
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{base_url}}/draft/{{tai_lieu_id}}", "host": ["{{base_url}}"], "path": ["draft", "{{tai_lieu_id}}"] }
      }
    },
    {
      "name": "DELETE /draft (clear TAT CA du thao)",
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{base_url}}/draft", "host": ["{{base_url}}"], "path": ["draft"] }
      }
    }
  ]
}
