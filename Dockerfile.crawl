# Service CRAWL: cao vbpl.vn -> schema meta. Noi DUY NHAT goi API vbpl.vn.
# Container chay nhu worker batch: exec cac lenh CLI khi can, vi du:
#   docker compose run --rm crawl python -m app.crawl.cli crawl --limit 5
#   docker compose run --rm crawl python -m app.crawl.cli fetch-cay --id 66801
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY app ./app
COPY scripts ./scripts
COPY migrations ./migrations

RUN pip install --no-cache-dir -e ".[dev]"

CMD ["python", "-m", "app.crawl.cli", "stats"]
